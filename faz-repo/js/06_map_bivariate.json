{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 320,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "view": {
    "fill": "#f3f5ef",
    "stroke": null
  },
  "projection": {
    "type": "mercator",
    "center": [
      109.5,
      4.1
    ],
    "scale": {
      "expr": "width * 2 * mapZoom"
    },
    "translate": {
      "expr": "[width / 2 + mapPanX, height / 2 + mapPanY]"
    }
  },
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2.0.2/countries-50m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.name != 'Antarctica'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#d9dbe0",
        "stroke": "#ffffff",
        "strokeWidth": 0.6,
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/malaysia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "MYSADM1gbOpen"
        }
      },
      "transform": [
        {
          "lookup": "properties.shapeName",
          "from": {
            "data": {
              "url": "data/state_summary.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "bivar": "string"
                }
              }
            },
            "key": "map_name",
            "fields": [
              "state",
              "income_mean",
              "inflation_yoy",
              "bivar"
            ]
          }
        },
        {
          "calculate": "'' + datum.bivar",
          "as": "bivar_s"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#565656",
        "strokeWidth": 1,
        "clip": true
      },
      "encoding": {
        "color": {
          "field": "bivar_s",
          "type": "nominal",
          "scale": {
            "domain": [
              "11",
              "21",
              "31",
              "12",
              "22",
              "32",
              "13",
              "23",
              "33"
            ],
            "range": [
              "#e9e9ee",
              "#b7c9e6",
              "#4a7fc4",
              "#f0bcb4",
              "#b89cb8",
              "#6a6fae",
              "#d9503f",
              "#a0507a",
              "#4a3a6e"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "income_mean",
            "type": "quantitative",
            "title": "Household income per month",
            "format": ",.0f"
          },
          {
            "field": "inflation_yoy",
            "type": "quantitative",
            "title": "Price rise (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/malaysia_states.topojson",
        "format": {
          "type": "topojson",
          "mesh": "malaysia_outline"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#1b2540",
        "strokeWidth": 2.4,
        "strokeJoin": "round",
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/state_centroids.csv"
      },
      "mark": {
        "type": "text",
        "fontSize": 8,
        "color": "#7a8296",
        "align": "center",
        "baseline": "middle",
        "clip": false
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "map_name",
          "type": "nominal"
        }
      }
    }
  ],
  "params": [
    {
      "name": "mapZoom",
      "value": 1
    },
    {
      "name": "mapPanX",
      "value": 0
    },
    {
      "name": "mapPanY",
      "value": 0
    }
  ]
}