{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 440,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "view": {
    "fill": "#f3f5ef",
    "stroke": null
  },
  "projection": {
    "type": "mercator",
    "center": [
      109.5,
      4.1
    ],
    "scale": {
      "expr": "width * 2 * mapZoom"
    },
    "translate": {
      "expr": "[width / 2 + mapPanX, height / 2 + mapPanY]"
    }
  },
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2.0.2/countries-50m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.name != 'Antarctica'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#d9dbe0",
        "stroke": "#ffffff",
        "strokeWidth": 0.6,
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/malaysia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "MYSADM1gbOpen"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#fbfbf6",
        "stroke": "#565656",
        "strokeWidth": 1,
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/malaysia_states.topojson",
        "format": {
          "type": "topojson",
          "mesh": "malaysia_outline"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#1b2540",
        "strokeWidth": 2.4,
        "strokeJoin": "round",
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/population_total_state.csv"
      },
      "transform": [
        {
          "filter": "datum.year == 2024"
        },
        {
          "lookup": "map_name",
          "from": {
            "data": {
              "url": "data/state_centroids.csv"
            },
            "key": "map_name",
            "fields": [
              "lon",
              "lat"
            ]
          }
        }
      ],
      "mark": {
        "type": "circle",
        "fill": "#73A5CA",
        "fillOpacity": 1,
        "stroke": "#ffffff",
        "strokeWidth": 0.8,
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "population_thousands",
          "type": "quantitative",
          "scale": {
            "range": [
              12,
              1500
            ]
          },
          "legend": {
            "title": "People (thousands)",
            "orient": "bottom-left",
            "fillColor": "#f3f5efcf",
            "padding": 6,
            "cornerRadius": 3,
            "offset": 4,
            "symbolFillColor": "#73A5CA",
            "symbolOpacity": 0.8
          }
        },
        "order": {
          "field": "population_thousands",
          "type": "quantitative",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "population_thousands",
            "type": "quantitative",
            "title": "People (thousands)",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "params": [
    {
      "name": "mapZoom",
      "value": 1
    },
    {
      "name": "mapPanX",
      "value": 0
    },
    {
      "name": "mapPanY",
      "value": 0
    }
  ]
}